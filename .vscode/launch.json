{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug telemetry_check (homework_05)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/debug/homework_05/telemetry_check",
      "args": [
        "${workspaceFolder}/homework_05/data/good.txt"
      ],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "environment": [],
      "externalConsole": false,
      "MIMode": "gdb",
      "setupCommands": [
        {
          "description": "Enable pretty-printing for gdb",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ],
      "preLaunchTask": "Build telemetry_check"
    }
  ]
}
